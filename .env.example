# PostgreSQL (docker compose uses DB_PASSWORD for the container)
DB_PASSWORD=change_me
DATABASE_URL=postgresql://election:change_me@localhost:5432/elections
# Used by integration tests; the database is wiped by the tests
TEST_DATABASE_URL=postgresql://election:change_me@localhost:5432/elections_test

# Free keys
FEC_API_KEY=your_fec_api_key            # https://api.open.fec.gov/developers/
CENSUS_API_KEY=your_census_api_key      # https://api.census.gov/data/key_signup.html
GOOGLE_CIVIC_API_KEY=                   # https://console.cloud.google.com/ (Civic Information API)

# Optional
ELECTION_ORG_API_KEY=
CIVICAPI_BASE_URL=https://civicapi.org/api/v2

ELECTION_YEAR=2026
LOG_LEVEL=INFO
